# NeuroShield Monorepo Environment Configuration
# Copy this file to .env in each corresponding app or use directly with Docker/Turborepo

# ------------------------------------------------------------------------------
# Backend API (apps/api/.env)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://neuroshield:neuroshield_password@localhost:5434/neuroshield_db?schema=public"
API_PORT=3005
JWT_SECRET="neuroshield-super-secret-jwt-key-change-in-production"
API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# Mobile Application (apps/mobile/.env)
# ------------------------------------------------------------------------------
# In Expo, use EXPO_PUBLIC_ prefix for client-accessible variables:
EXPO_PUBLIC_API_URL="http://10.0.2.2:3005"
