{
  "name": "lumo-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check:honesty": "node scripts/check-no-fake-success.mjs"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.1.2",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "patchedDependencies": {
      "@react-native-voice/voice@3.2.4": "patches/@react-native-voice__voice@3.2.4.patch"
    }
  }
}
