# ==============================================================================
# NeuroShield Monorepo .gitignore
# ==============================================================================

# OS & Filesystem
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Environment Variables & Secrets (NEVER commit secrets!)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.template

# Dependencies
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Build Outputs & Monorepo Caches
# ------------------------------------------------------------------------------
dist/
**/dist/
build/
**/build/
.turbo/
**/.turbo/
*.tsbuildinfo
**/*.tsbuildinfo

# Expo & React Native (Managed Workflow)
# ------------------------------------------------------------------------------
.expo/
**/.expo/
.expo-shared/
**/.expo-shared/
web-build/
**/web-build/
*.jsbundle
.metro-health-check*

# Native Prebuild Outputs (Generated dynamically via `expo prebuild` / `expo run:*`)
# ------------------------------------------------------------------------------
android/
**/android/
ios/
**/ios/

# Android & Gradle Artifacts
# ------------------------------------------------------------------------------
.gradle/
**/.gradle/
local.properties
**/local.properties
*.iml
*.hprof
.cxx/
**/.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
*.keystore
*.jks
*.jar
*.aar

# iOS & Xcode Artifacts
# ------------------------------------------------------------------------------
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
**/xcuserdata/
*.xccheckout
*.moved-aside
DerivedData/
**/DerivedData/
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local
**/Pods/
**/Podfile.lock
/vendor/bundle/
**/vendor/bundle/
.bundle/
**/.bundle/

# Testing & Coverage
# ------------------------------------------------------------------------------
coverage/
**/coverage/
*.lcov
.nyc_output/

# Logs
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Fastlane
# ------------------------------------------------------------------------------
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# IDEs & Editors
# ------------------------------------------------------------------------------
.idea/
**/.idea/
.vscode/
**/.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
