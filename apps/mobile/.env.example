# Lumo mobile app environment
# Copy to .env — Expo inlines EXPO_PUBLIC_* variables at build time.

# Base URL of the Lumo API. Required for any build that is not run against a
# local Metro bundler; a release build without it cannot reach the backend.
# EXPO_PUBLIC_API_URL="https://api.lumo.example"

# Port used by the development fallback, which derives the host from whichever
# machine is serving the JS bundle. Must match API_PORT in apps/api/.env.
EXPO_PUBLIC_API_PORT=3005
