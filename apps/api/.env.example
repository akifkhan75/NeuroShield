# Lumo NestJS API Environment Variables
# Copy this file to .env and adjust values for your local environment

# Database connection string (PostgreSQL)
# Lumo default runs on host port 5434
DATABASE_URL="postgresql://lumo:lumo_password@localhost:5434/lumo_db?schema=public"

# HTTP server port for NestJS
API_PORT=3005

# JWT authentication secret for securing endpoints
JWT_SECRET="lumo-super-secret-jwt-key-change-in-production"

# Google Gemini API key for emergency assistance & safety tips
API_KEY="your-gemini-api-key-here"
